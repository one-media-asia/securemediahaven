# Copy this file to .env.local and replace each value with a live or test link.
VITE_STRIPE_ALL_ACCESS_URL=
VITE_STRIPE_LAUNCH_HOSTING_URL=
VITE_STRIPE_STUDIO_HOSTING_URL=
VITE_STRIPE_STUDIO_DOMAIN_URL=
VITE_STRIPE_LEARNKIT_URL=
VITE_STRIPE_FOCUS_SCHOOL_URL=
VITE_STRIPE_DOMAIN_HOSTING_URL=

# Vaultline S3 storage. Leave the API base empty when the server shares this domain.
VITE_STORAGE_MODE=aws
VITE_API_BASE_URL=

# Server-only values. Use an IAM role/profile in production when possible.
AWS_REGION=us-east-1
AWS_S3_BUCKET=your-vaultline-bucket
AWS_S3_PREFIX=vaultline

.......# Add one Stripe Payment Link per product.
# Copy this file to .env.local and replace each value with a live or test link.
VITE_STRIPE_LAUNCH_HOSTING_URL=https://buy.stripe.com/8x2eVd8hyacyeJ61PN7EQ0c
VITE_STRIPE_VPN_URL=https://buy.stripe.com/https://buy.stripe.com/14AbJ1fK02K630o2TR7EQ0d

# Server-side email delivery. Never prefix these with VITE_.
RESEND_API_KEY=
# Change this to any sender address verified in Resend.
RESEND_FROM_EMAIL=security@onemedia.asia
# The display name recipients see next to the verified sender address.
RESEND_FROM_NAME=appfolk Security
ALLOWED_ORIGIN=https://phish.onemedia.asia

# Server-only owner bypass for VulnScan. Never prefix with VITE_.
VULNSCAN_ADMIN_KEY=

# --- CyberAgent (Claude on Amazon Bedrock) ---
# Inference is paid per token, so /api/chat verifies access server-side
# before calling Bedrock. Generate a random secret:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ACCESS_COOKIE_SECRET=
CYBERAGENT_ADMIN_KEY=
# CyberAgent pricing on the "Cyber Agent" Stripe product: $6.99/month.
# Create a $6.99/month recurring price in Stripe and paste
# its ID here. The subscription is created with an exact trial_end because
# Stripe Checkout cannot start a trial shorter than 48 hours.
CYBERAGENT_MONTHLY_PRICE_ID=

# Metered allowance per paying customer. Enforced server-side in the signed
# session cookie, so a user cannot reset it by clearing browser storage.
CYBERAGENT_TOKEN_LIMIT=3000000
CYBERAGENT_PERIOD_DAYS=30
CYBERAGENT_MAX_TOKENS=8192

# AWS credentials for Bedrock. On Vercel set AWS_ACCESS_KEY_ID,
# AWS_SECRET_ACCESS_KEY and AWS_REGION. Locally, `aws login --profile agent-toolkit`
# already authenticates the SDK and AWS_REGION must be set explicitly.
AWS_REGION=eu-north-1

# DeepSeek V3 — not throttled on this account and ~20x cheaper than Sonnet, so
# the 3M-token plan has real margin. Bedrock serves it with the OpenAI wire
# format; the handler detects and handles both.
CYBERAGENT_MODEL_ID=deepseek.v3-v1:0

# Optional higher-quality fallback if the primary is throttled or unavailable,
# so customers never see a 429. Leave empty to disable the retry path.
# CYBERAGENT_FALLBACK_MODEL_ID=eu.anthropic.claude-sonnet-4-6
{
  "redirects": [
    {
      "source": "/",
      "destination": "/cyberagent",
      "has": [{ "type": "host", "value": "cyberagent.onemedia.asia" }],
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" }
      ]
    }
  ]
}
